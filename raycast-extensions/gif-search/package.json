{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "gif-search",
  "title": "GIF Search",
  "description": "Search GIPHY, preview the results in a grid and paste, copy or download the one you pick.",
  "icon": "icon.png",
  "author": "lucasteloeken",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Fun",
    "Media"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "search-gifs",
      "title": "Search GIFs",
      "subtitle": "GIPHY",
      "description": "Search GIPHY and paste, copy or download a GIF.",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "apiKey",
      "type": "password",
      "required": true,
      "title": "GIPHY API Key",
      "description": "Create one at https://developers.giphy.com/dashboard/. Raycast stores it in the keychain, so it never lands in the dotfiles repo."
    },
    {
      "name": "rating",
      "type": "dropdown",
      "required": false,
      "title": "Rating",
      "description": "Highest content rating to include.",
      "default": "g",
      "data": [
        {
          "title": "G",
          "value": "g"
        },
        {
          "title": "PG",
          "value": "pg"
        },
        {
          "title": "PG-13",
          "value": "pg-13"
        },
        {
          "title": "R",
          "value": "r"
        }
      ]
    },
    {
      "name": "columns",
      "type": "dropdown",
      "required": false,
      "title": "Grid Columns",
      "description": "Fewer columns means bigger GIFs.",
      "default": "3",
      "data": [
        {
          "title": "2 (largest)",
          "value": "2"
        },
        {
          "title": "3",
          "value": "3"
        },
        {
          "title": "4",
          "value": "4"
        },
        {
          "title": "5",
          "value": "5"
        },
        {
          "title": "6 (smallest)",
          "value": "6"
        }
      ]
    },
    {
      "name": "aspectRatio",
      "type": "dropdown",
      "required": false,
      "title": "Cell Shape",
      "description": "Most GIFs are square-ish; a wider cell leaves empty bars around them.",
      "default": "1",
      "data": [
        {
          "title": "Square",
          "value": "1"
        },
        {
          "title": "4:3",
          "value": "4/3"
        },
        {
          "title": "3:2",
          "value": "3/2"
        },
        {
          "title": "16:9",
          "value": "16/9"
        }
      ]
    },
    {
      "name": "fit",
      "type": "dropdown",
      "required": false,
      "title": "Scaling",
      "description": "Fill uses the whole cell and crops the edges. Contain shows the whole GIF, smaller.",
      "default": "fill",
      "data": [
        {
          "title": "Fill (bigger, crops)",
          "value": "fill"
        },
        {
          "title": "Contain (whole GIF)",
          "value": "contain"
        }
      ]
    },
    {
      "name": "downloadDir",
      "type": "textfield",
      "required": false,
      "title": "Download Folder",
      "description": "Where the Download GIF action saves files.",
      "default": "~/Downloads"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.4.1",
    "@raycast/utils": "^2.3.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
