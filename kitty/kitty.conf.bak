# BEGIN_KITTY_THEME
# Rosé Pine Moon
include current-theme.conf
# END_KITTY_THEME
#
font_family JetBrains Mono

cursor_shape beam
cursor_trail 2
cursor_trail_decay 0.1 0.3

background_opacity 0.7
# Desfoque do fundo (ajuste o valor conforme preferir)
background_blur 40

# Remove window title bar
hide_window_decorations titlebar-only

# Cor da barra de título integrada ao fundo (macOS)
# macos_titlebar_color background
# wayland_titlebar_color background
linux_display_server x11

# Mapeamento das teclas para parecer linux
map cmd+shift+t new_tab 

map cmd+shift+comma move_tab_backward
map cmd+shift+period move_tab_forward

map cmd+shift+left previous_tab
map cmd+shift+right next_tab

map cmd+w close_tab

# Mapeamento do command
map cmd+space send_text all \x01
