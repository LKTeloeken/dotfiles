{
  "symbols.hidesExplorerArrows": false,
  "workbench.iconTheme": "symbols",
  "editor.formatOnSave": true,
  "editor.fontFamily": "JetBrains Mono",
  "editor.fontLigatures": true,
  "editor.fontSize": 13,
  "editor.lineHeight": 1.8,
  "js/ts.suggest.autoImports": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "editor.minimap.enabled": false,
  "workbench.startupEditor": "none",
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "./node_modules/typescript",
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "typescriptreact": true,
    "typescript": true,
  },
  "editor.accessibilitySupport": "off",
  "terminal.integrated.defaultProfile.osx": "fish",
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "*.db": "default",
  },
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
    "Cargo.toml": "Cargo.lock",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*",
  },
  "vscode-pets.theme": "forest",
  "workbench.activityBar.location": "default",
  "workbench.navigationControl.enabled": false,
  "window.commandCenter": false,
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "git.confirmSync": false,
  "github.copilot.nextEditSuggestions.enabled": false,
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/*.stories.*": true,
  },
  "editor.disableMonospaceOptimizations": true,
  "explorer.compactFolders": false,
  "python.analysis.typeCheckingMode": "basic",
  "diffEditor.ignoreTrimWhitespace": false,
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cn\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"],
    [
      "(?:const|let|var)\\s+\\w+\\s*[:=]\\s*{([^}]*)",
      "(?:'|\"|`)([^'\"`]*)(?:'|\"|`)",
    ],
    ["tw`([^`]*)`", "([^`]*)"],
    ["tw\\('([^']*)'\\)", "([^']*)"],
    ["tw\\(\"([^\"]*)\"\\)", "([^\"]*)"],
  ],
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript",
  },
  "chat.tips.enabled": false,
  "sol.languageServerPath": "~/Documents/projects/unisc/compiladores/sol-lang/solls",
  "claudeCode.preferredLocation": "panel",
  "claudeCode.focusView": true,
  // islands.css restyles the modern UI floating panels, whose layout reserves
  // the gaps. Frosted glass off: its blur breaks the picker animations.
  "workbench.experimental.modernUI": true,
  "workbench.modernUIFrostedGlass": false,
  "custom-ui-style.external.imports": [
    "file://${userHome}/projects/personal/vscode-dark-islands/islands.css",
  ],
  "workbench.layoutControl.enabled": false,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "workbench.browser.showInTitleBar": false,
  "workbench.colorTheme": "Rosé Pine (no italics)",
  "editor.cursorSmoothCaretAnimation": "on",
}
