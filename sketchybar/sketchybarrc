PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/styles.sh"

# General Bar Properties
sketchybar --bar position=top \
               height=$BAR_HEIGHT \
               blur_radius=$BAR_BLUR_RADIUS \
               color=$COLOR_TRANSPARENT \
               display=main \
               topmost=window \
               y_offset=$BAR_Y_OFFSET \
               margin=$BAR_MARGIN

# Item Defaults
sketchybar --default \
           padding_left=$ITEM_PADDING_LEFT \
           padding_right=$ITEM_PADDING_RIGHT \
           icon.font="$FONT_ICON_DEFAULT" \
           label.font="$FONT_LABEL_DEFAULT" \
           icon.color="$DEFAULT_ICON_COLOR" \
           label.color="$DEFAULT_LABEL_COLOR" \
           icon.padding_left=$ITEM_ICON_PADDING_LEFT \
           icon.padding_right=$ITEM_ICON_PADDING_RIGHT \
           label.padding_left=$ITEM_LABEL_PADDING_LEFT \
           label.padding_right=$ITEM_LABEL_PADDING_RIGHT \
           background.color="$DEFAULT_BACKGROUND_COLOR" \
           background.border_width=$ITEM_BG_BORDER_WIDTH \
           background.corner_radius=$ITEM_BG_CORNER_RADIUS \
           background.height=$ITEM_BG_HEIGHT \
           blur_radius=$BAR_BLUR_RADIUS 

sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_mode_changed

# --- Items on the right ---
# Date and time
sketchybar --add item date right \
           --set date icon=􀧞 \
                      icon.color="$DEFAULT_ICON_COLOR" \
                      label.color="$CONTENT_LABEL_COLOR" \
                       update_freq=5 \
                      script="$PLUGIN_DIR/date.sh"

# Battery level
sketchybar --add item battery right \
           --set battery icon.color="$DEFAULT_ICON_COLOR" \
                         label.color="$CONTENT_LABEL_COLOR" \
                         update_freq=10 \
                         script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change

# Volume level
sketchybar --add item volume right \
           --set volume icon.color="$DEFAULT_ICON_COLOR" \
                        label.color="$CONTENT_LABEL_COLOR" \
                        script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change

# Media (Spotify/Music)
source "$CONFIG_DIR/items/media.sh"

