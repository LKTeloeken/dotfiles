#!/opt/homebrew/bin/lua

-- Entry point. Runs as one long-lived Lua process (SbarLua): items written in
-- Lua get their events as callbacks over mach, with no process spawned per
-- click, scroll or hover.
--
-- Absolute shebang: when aerospace starts the bar, PATH may not include
-- Homebrew yet.

package.cpath = package.cpath .. ";" .. os.getenv("HOME") .. "/.local/share/sketchybar_lua/?.so"
package.path = package.path .. ";" .. os.getenv("CONFIG_DIR") .. "/lua/?.lua"

sbar = require("sketchybar")

local S = require("styles")

sbar.bar({
  position = "top",
  height = S.num("BAR_HEIGHT"),
  blur_radius = S.num("BAR_BLUR_RADIUS"),
  color = S.COLOR_TRANSPARENT,
  display = "main",
  topmost = "window",
  y_offset = S.num("BAR_Y_OFFSET"),
  margin = S.num("BAR_MARGIN"),
})

sbar.default({
  padding_left = S.num("ITEM_PADDING_LEFT"),
  padding_right = S.num("ITEM_PADDING_RIGHT"),
  icon = {
    font = S.FONT_ICON_DEFAULT,
    color = S.DEFAULT_ICON_COLOR,
    padding_left = S.num("ITEM_ICON_PADDING_LEFT"),
    padding_right = S.num("ITEM_ICON_PADDING_RIGHT"),
  },
  label = {
    font = S.FONT_LABEL_DEFAULT,
    color = S.DEFAULT_LABEL_COLOR,
    padding_left = S.num("ITEM_LABEL_PADDING_LEFT"),
    padding_right = S.num("ITEM_LABEL_PADDING_RIGHT"),
  },
  background = {
    color = S.DEFAULT_BACKGROUND_COLOR,
    border_width = S.num("ITEM_BG_BORDER_WIDTH"),
    corner_radius = S.num("ITEM_BG_CORNER_RADIUS"),
    height = S.num("ITEM_BG_HEIGHT"),
  },
  blur_radius = S.num("BAR_BLUR_RADIUS"),
})

-- Triggered by exec-on-workspace-change in ~/.aerospace.toml
sbar.add("event", "aerospace_workspace_change")

-- Native helpers (helpers/Makefile): a no-op unless a source file changed.
os.execute("make -s -C \"$CONFIG_DIR/helpers\" >/dev/null 2>&1")

-- All items, sent to sketchybar as one batch. Right-side items are added
-- right to left.
sbar.begin_config()
require("items.spaces")
require("items.front_app")
require("items.date")
require("items.battery")
require("items.wifi")
-- Brightness widget (lua/items/brightness.lua): off for now, uncomment to use.
-- require("items.brightness")
require("items.volume")
require("items.media")
sbar.end_config()

-- Never returns: from here on the process only reacts to events.
sbar.event_loop()
